{
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "rootDirectory": "frontend",
        "spa": true
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "frontend/dist/index.html" }
  ]
}
