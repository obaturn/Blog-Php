# Application - Copy this file to .env and update values
APP_NAME=SocialBlog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=sqlite  # or mysql for production
# For MySQL, uncomment and configure:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=socialblog
# DB_USERNAME=root
# DB_PASSWORD=

# Session - Set SESSION_ENCRYPT=true in production
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue
QUEUE_CONNECTION=database

# Cache
CACHE_STORE=file
CACHE_TTL=300

# Sanctum (API Authentication) - IMPORTANT for production
# Set SANCTUM_TOKEN_EXPIRATION for token expiry (7 days = 10080 minutes)
SANCTUM_TOKEN_EXPIRATION=10080

# Cloudinary (Media Upload) - REPLACE THESE WITH YOUR OWN
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_SECURE=true
# MEDIA_DRIVER=cloudinary

# Feed Configuration
FEED_CACHE_TTL=300
FEED_MAX_POSTS=50
FEED_DEFAULT_LIMIT=15
FEED_LIKE_WEIGHT=2
FEED_COMMENT_WEIGHT=3
FEED_CACHE_ENABLED=true
FEED_STRATEGY=fan_out_on_read

# Vite
VITE_APP_NAME="${APP_NAME}"