# SocialBlog .env Template
# Copy this file to .env and fill in real values
# This file is committed to Git - it contains NO real secrets

# Application
APP_NAME=SocialBlog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend (Vercel)
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Mail - local uses log; production should use SMTP, SES, Postmark, or Resend
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Database - use managed MySQL or PostgreSQL in production
DB_CONNECTION=sqlite
# For MySQL:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=socialblog
# DB_USERNAME=root
# DB_PASSWORD=
# For PostgreSQL (Render):
# DB_CONNECTION=pgsql
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_DATABASE=socialblog
# DB_USERNAME=your-user
# DB_PASSWORD=your-password

# Session - use secure cookies and HTTPS in production
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Queue - use Redis or managed queue in production
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# Cache - use Redis or managed cache in production
CACHE_STORE=file
CACHE_TTL=300

# Sanctum (API Authentication)
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=

# Password and account security
AUTH_PASSWORD_TIMEOUT=10800

# Cloudinary (Media Upload) - replace these with your own in production
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_SECURE=true
# MEDIA_DRIVER=cloudinary
# MEDIA_DRIVER=local

# Feed Configuration
FEED_CACHE_TTL=300
FEED_MAX_POSTS=50
FEED_DEFAULT_LIMIT=15
FEED_LIKE_WEIGHT=2
FEED_COMMENT_WEIGHT=3
FEED_CACHE_ENABLED=true
FEED_STRATEGY=fan_out_on_read

# CORS - add your frontend URL(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:8000

# Vite
VITE_APP_NAME="${APP_NAME}"
